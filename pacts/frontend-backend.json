{
  "consumer": {
    "name": "frontend"
  },
  "interactions": [
    {
      "description": "request to create short link",
      "pending": false,
      "providerStates": [
        {
          "name": "backend accepts link creation"
        }
      ],
      "request": {
        "body": {
          "content": {
            "long_url": "https://www.ramirez.com/"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/api/link"
      },
      "response": {
        "body": {
          "content": {
            "slug": "http://localhost:8080/api/s/abcdefghij"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^http://localhost:8080/api/s/.{10}$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "backend"
  }
}